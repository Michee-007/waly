{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waly",
  "version": "0.1.0",
  "identifier": "ai.waly.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Waly",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-sync --disable-domain-reliability --no-pings --disable-component-update --disable-breakpad --metrics-recording-only"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; manifest-src 'self'",
      "capabilities": ["default"],
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  }
}
